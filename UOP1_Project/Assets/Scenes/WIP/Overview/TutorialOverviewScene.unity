  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Animator uses idle, walking and running clips without the character
    holding his walking cane. This gives clean animation clips where both hands are
    free which we can use in cutscenes to create some variety. \r\n\nFor gameplay
    though we rigged the character with extra controls to allow him to wield the
    walking cane when performing these actions. \r\nSpecifically, we added a walking
    cane on his right hand so that the hand is locked onto the walking cane when
    needed. (RightHandIK)\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fe129390af88b40faa85c89db6820ea6, type: 2}
