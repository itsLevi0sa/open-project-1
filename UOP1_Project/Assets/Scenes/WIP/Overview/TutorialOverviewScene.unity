  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: We decided the winning dish to be the dish that would stand out from the
    crowd and bring something new to the festival. Following the premise of cooking
    being all about creativity, originality and surprise, our main goal became for
    the players to think of a recipe on their own and go against the safe, usual
    routes everybody is used to follow. In this sense, the winning dish could not
    possibly be made by a recipe the player has already acquired from the locals!
    It will have to be made up, however the narrative will give clues on what the
    player could use. So the end goal is for the players to create something on their
    own, surprising themselves that they found the answer to the "narrative puzzle"
    and also surprising the legendary chef, who tried something completely new that
    actually changed his viewpoint.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fe129390af88b40faa85c89db6820ea6, type: 2}
