      m_Calls: []
  m_text: "We plan to use this also for other characters. \nFor instance: the ones
    who are holding an object, so we can swap in object-wielding animations very
    much like the ones we made for Pig Chef.\r                                                                    
    This means we only need to manage one Animator Controller and the changes will
    be reflected to all Townsfolk eliminating tedious work and potential mistakes.\r\n\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fe129390af88b40faa85c89db6820ea6, type: 2}
