    m_PersistentCalls:
      m_Calls: []
  m_text: 'Another interesting, simple but effective effect to add life to characters
    is to have NPCs look at the player when he gets close enough.

    We can achieve
    this by using the Multi-Aim constraint in the Animation Rigging package and a
    simple trigger zone so that the constraint is gradually turned on creating the
    illusion that the NPC is turning its head.

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fe129390af88b40faa85c89db6820ea6, type: 2}
