  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Cerise is a top chef too, much respected like Comb, that lives in a hidden,
    isolated place in the Forest. She has no interest in the Cooking Contest as she
    is more interested in the process of cooking itself rather than winning. She
    has devoted her life to find new, interesting flavors, and is mainly indulged
    with sweet tastes, the ones that the contest does not seem to favor much anyways.
    \nShe is the one that hands Hamlet the pepper he needs as soon as he reveals
    to her the accidental Rock Candy recipe he invented. She also gives him additional
    information on the Golden Egg, that used to be the main island's ingredient,
    but the extinction of it kickstarted the Festival in search of new dishes that
    could top it's taste without it.\n"
