  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "To make the idle more unpredictable we created multiple idle clips and
    we played them randomly when the previous one is over or when coming back from
    the Walk state.\r\nThere are several ways to achieve this but we went with attaching
    a StateMachine Behaviour to the Idle state which OnStateEnter sets an integer
    to a random value.\n\n\nThis means that the next time the state machine has to
    transition to an idle state, a different idle will be played. \r\nWe do the same
    thing for other characters that have variations like for the Bard Hare\u2019s
    singing.\r\n\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: fe129390af88b40faa85c89db6820ea6, type: 2}
  m_sharedMaterial: {fileID: -5592514773993622969, guid: fe129390af88b40faa85c89db6820ea6,
